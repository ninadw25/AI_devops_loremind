# LOCAL secrets template — DO NOT COMMIT populated values.
# Copy to .env and fill with your own credentials.

# ── AI / LLM Providers ────────────────────────────────────────────────
# Which provider runs Stage 5 triple extraction: nvidia | openrouter | bedrock
LLM_PROVIDER=bedrock
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Stage 5 active model when llm_provider=openrouter
OPENROUTER_LLM_MODEL=google/gemini-2.5-flash
GROQ_API_KEY=

# ── AWS Bedrock (Stage 5 extraction — DeepSeek V3.2, ap-south-1) ──────
# OpenAI-compatible bedrock-mantle endpoint; the Bedrock API key is the
# bearer token. BEDROCK_BASE_URL empty → derived as
# https://bedrock-mantle.<region>.api.aws/v1
BEDROCK_API_KEY=
BEDROCK_REGION=ap-south-1
BEDROCK_BASE_URL=
BEDROCK_MODEL=deepseek.v3.2
# Conservative starting budget (Bedrock throttles on RPM *and* TPM).
# Raise via Service Quotas once real limits are known.
BEDROCK_RPM=30
BEDROCK_TPM=150000
BEDROCK_CONCURRENCY=4

# Extraction model override (optional)
# DeepSeek (deepseek-ai/deepseek-v3.2) is only the NVIDIA-path setting
# and is not the active Stage 5 model when OpenRouter is selected.
EXTRACTION_MODEL=google/gemini-2.5-flash

# ── Embeddings provider / model ───────────────────────────────────────
# Provider for Stage 6.5 embeddings. Default: `nvidia` (NVIDIA NeMo endpoint).
# If your provider deprecates a model you may receive HTTP 410 responses
# from the embeddings endpoint — change `EMBEDDING_MODEL` to a supported model.
EMBEDDING_PROVIDER=nvidia
# Recommended default (2048-dim): nvidia/nemotron-3-embed-1b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIM=2048


# ── Org ───────────────────────────────────────────────────────────────
# Required: used to namespace all output files and as the --org flag value.
# Can also be passed directly as --org <name> on each pipeline command.
# ORG=your-org-slug

# ── Core Auth ──────────────────────────────────────────────────────────
AUTH_USERS={"admin":"<sha256>","ezobooks":"<sha256>"}
AUTH_USER_ORGS={"admin":"*","ezobooks":"ezobooks"}
AUTH_SALT=<change-me>
JWT_SECRET_KEY=<change-me>

# ── Chronograph store: PostgreSQL + pgvector ──────────────────────────
# DATABASE_URL takes precedence over POSTGRES_URI.
# DATABASE_URL=postgresql://user:pass@localhost:5434/lore_chronograph
# POSTGRES_URI=postgresql://user:pass@localhost:5434/lore_chronograph

# ── Neo4j Aura credentials (preferred) ───────────────────────────────
# Builder maps these to legacy NEO4J_* names when needed.
NEO4J_AURA_URI=
NEO4J_AURA_USER=
NEO4J_AURA_PASSWORD=

# ── Neo4j direct credentials (local or explicit) ─────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<change-me>

# ── Neo4j — claim substrate projection (build step 7), separate instance ──
# See neo4j/docker-compose.claims.yml. Never the same database as NEO4J_URI
# above — the old naked-triple ontology and the new claim projection must
# not share a graph.
CLAIMS_NEO4J_URI=bolt://localhost:7688
CLAIMS_NEO4J_USERNAME=neo4j
CLAIMS_NEO4J_PASSWORD=<change-me>

# ── Per-org connection guard (turn ON wherever >1 client's data exists) ─
# Leave unset locally. Set true on any shared/staging/prod host.
#
# Why: the credentials above are whatever this machine happens to have. This
# process is org-agnostic — normally the ingestion control API resolves the
# right client's database from the registry and injects it per run. But a
# hand-run `python -m builders.unified_builder --org clientA` skips all that and
# uses the values above. If they point at clientB, clientA's knowledge is
# written into clientB's graph, silently, looking like a clean run.
#
# With this on, a run must carry the control plane's LORE_CONNECTION_ORG stamp
# and that stamp must name the org being built — otherwise it refuses to
# connect. Start runs via the control API (POST /runs) on such hosts.
REQUIRE_REGISTRY_CONNECTION=false

# ── JIRA / Atlassian ──────────────────────────────────────────────────
JIRA_BASE_URL=https://<your-tenant>.atlassian.net
JIRA_TYPE=cloud
JIRA_EMAIL=<your-email>
JIRA_API_TOKEN=
# Alternative auth (fallback if email+token absent)
JIRA_OAUTH_TOKEN=
JIRA_PAT=

# ── Slack connector ───────────────────────────────────────────────────
SLACK_APP_TIER=marketplace
SLACK_REQUEST_DELAY=1.0
SLACK_WORKSPACE_ID=
# Workspace subdomain for citation URLs (https://<domain>.slack.com/...)
SLACK_WORKSPACE_DOMAIN=
SLACK_TOKEN=
SLACK_ORG=ezobooks
SLACK_INGEST_MODE=polling
SLACK_SCANBACK_DAYS=14
SLACK_DEFAULT_RETRY_SLEEP=5.0
SLACK_BOT_ALLOWLIST=

# ── Google / Gmail ────────────────────────────────────────────────────
# Path to service account key with Domain-Wide Delegation
# Scopes: gmail.readonly, admin.directory.user.readonly
# GOOGLE_KEY_FILE=key.json

# ── Microsoft 365 / Outlook + Teams ─────────────────────────────────
# Required for real Microsoft Graph API access.
#
# How to obtain these values:
#   1. Register an app in Azure portal → Azure Active Directory → App registrations
#   2. Copy Tenant ID and Client ID from the app Overview page
#   3. Create a Client Secret under Certificates & secrets
#   4. Add Application permissions: Mail.Read, ChannelMessage.Read.All,
#      User.Read.All, ChannelMember.Read.All
#   5. Grant admin consent for all four permissions
#
# See: docs/Outlook/REQUIREMENTS.md for the full step-by-step guide.
# See: docs/Outlook/LOR-14_Outlook_Connector_architecture.md §7 for
#      the admin consent URL and permission reference.
#
# Both AZURE_* (original) and MS365_* (LOR-66 alias) naming are supported.
# Set one pair — the connector resolves whichever is present.
# If both are set, MS365_* takes precedence.

# Primary naming (used by fetcher.py and validate_for("outlook_fetch")):
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Alternative LOR-66 naming (preferred for new setups):
# MS365_TENANT_ID=
# MS365_CLIENT_ID=
# MS365_CLIENT_SECRET=

# ── MS365 behavioural tuning (optional — defaults are shown) ─────────
# Override the Graph API base URL (leave blank for the standard endpoint):
# MS365_BASE_URL=https://graph.microsoft.com/v1.0
#
# How far back to fetch on the FIRST (full) sync.
# Incremental syncs after the first run use delta tokens and ignore these.
# MS365_MAIL_SCANBACK_DAYS=90
# MS365_TEAMS_SCANBACK_DAYS=30

# ── Connector credentials on a MULTI-TENANT host ────────────────────────
# Everything in the per-connector sections below (ZOHO_*, SLACK_*, JIRA_*) is
# for SINGLE-tenant use — a laptop, or a box that serves exactly one client.
#
# On the shared control-plane host, set VAULT_PROXY_URL instead. The control API
# then resolves each run's data-store creds AND its connector secret from that
# tenant's Vault subtree (secret/tenants/{org}/{neo4j,postgres,zoho,...}) and
# STRIPS the variables below from the runner's environment, so one tenant's run
# can never inherit another's token. A tenant with no Vault entry fails the run
# rather than falling back.
# VAULT_PROXY_URL=http://vault-proxy:8080
# VAULT_PROXY_TOKEN=

# ── Zoho (Mail + Cliq connector, LOR-13) ────────────────────────────────
# Self-client OAuth (no redirect URI): register a Self Client at
# https://api-console.zoho.com, generate a grant code with scopes
# ZohoMail.messages.READ ZohoMail.accounts.READ ZohoCliq.Channels.READ
# ZohoCliq.Messages.READ ZohoCliq.Users.READ, then exchange it once for a
# refresh token (POST /oauth/v2/token with grant_type=authorization_code).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data center hosting the org's Zoho account — changes accounts/mail/cliq
# hostnames (accounts.zoho.{dc}, mail.zoho.{dc}, cliq.zoho.{dc}).
# One of: com | in | eu | au | jp
ZOHO_DATA_CENTER=com

# ── Zoho behavioural tuning (optional — defaults are shown) ─────────────
# Cliq org id, used by admin-scoped discovery calls:
# ZOHO_ORG_ID=
#
# How far back to fetch on the FIRST (full) sync. Zoho has no native
# delta-link, so incremental syncs use a client-side watermark cursor
# instead — these only apply when no cursor exists yet.
# ZOHO_MAIL_SCANBACK_DAYS=90
# ZOHO_CLIQ_SCANBACK_DAYS=30

# ── GitLab ────────────────────────────────────────────────────────────
# GITLAB_PAT=
# GITLAB_BASE_URL=https://gitlab.com
